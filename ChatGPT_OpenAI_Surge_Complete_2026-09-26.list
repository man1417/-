# NAME: ChatGPT / OpenAI - FINAL DIRECT
# FORMAT: Surge Rule Set
# UPDATED: 2026-10-06
#
# PURPOSE:
#   Route ChatGPT / OpenAI / Codex traffic to the dedicated AI policy.
#   Designed for profiles using FINAL,DIRECT.
#
# IMPORTANT:
#   Use this RULE-SET with extended-matching.
#
#   Example:
#   RULE-SET,<THIS_URL>,Intelligence,extended-matching
#
#   Main profile:
#   FINAL,DIRECT
#
# ============================================================
# macOS process fallback
# ============================================================
#
# Surge Mac only.
# iOS ignores PROCESS-NAME rules.
#
# App Bundle Mode catches ChatGPT and its helper processes.
PROCESS-NAME,/Applications/ChatGPT.app/

# Confirmed from actual Surge runtime traffic
PROCESS-NAME,codex
PROCESS-NAME,Codex*

# ============================================================
# OpenAI / ChatGPT official core
# ============================================================

DOMAIN-SUFFIX,openai.com
DOMAIN-SUFFIX,chatgpt.com

# Static assets / uploads / telemetry
DOMAIN-SUFFIX,oaistatic.com
DOMAIN-SUFFIX,oaiusercontent.com
DOMAIN-SUFFIX,oaistatsig.com

# Email / verification
DOMAIN-SUFFIX,ct.sendgrid.net

# Support frontend
DOMAIN-SUFFIX,intercom.io
DOMAIN-SUFFIX,intercomcdn.com

# ============================================================
# OpenAI CDN
# ============================================================

DOMAIN,cdn.openaimerge.com

# ============================================================
# Authentication / WorkOS
# ============================================================

DOMAIN,cdn.workos.com
DOMAIN,forwarder.workos.com
DOMAIN,images.workoscdn.com
DOMAIN,setup.workos.com
DOMAIN,workos.imgix.net

# ============================================================
# Cloudflare challenge
# ============================================================

DOMAIN,challenges.cloudflare.com

# ============================================================
# Payment
# ============================================================

DOMAIN,js.stripe.com

# ============================================================
# Diagnostics / telemetry
# Exact hosts only — avoid broad shared suffix pollution
# ============================================================

DOMAIN,o207216.ingest.sentry.io
DOMAIN,o33249.ingest.sentry.io
DOMAIN,rum.browser-intake-datadoghq.com

# ============================================================
# Apple native-app dependency
# ============================================================

DOMAIN,humb.apple.com

# ============================================================
# OpenAI CDN / storage infrastructure
# ============================================================

DOMAIN,chat.openai.com.cdn.cloudflare.net

DOMAIN,openaicom-api-bdcpf8c6d2e9atf6.z01.azurefd.net
DOMAIN,openaicomproductionae4b.blob.core.windows.net
DOMAIN,production-openaicom-storage.azureedge.net

DOMAIN-SUFFIX,openaiapi-site.azureedge.net
DOMAIN-SUFFIX,openaicom.imgix.net

# ============================================================
# Arkose anti-abuse / challenge
# ============================================================

DOMAIN,openai-api.arkoselabs.com
DOMAIN-SUFFIX,client-api.arkoselabs.com

# ============================================================
# ChatGPT realtime / voice infrastructure
# ============================================================

DOMAIN-SUFFIX,chatgpt.livekit.cloud
DOMAIN-SUFFIX,host.livekit.cloud
